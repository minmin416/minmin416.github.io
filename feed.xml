<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Riverplo — Writing</title><link>https://riverplo.com/writing/</link><description>Public writing from Riverplo</description><language>en</language><atom:link href="https://riverplo.com/feed.xml" rel="self" type="application/rss+xml" />{% assign public_posts = site.posts | where: "visibility", "public" | where_exp: "post", "post.published == true" %}{% for post in public_posts %}<item><title>{{ post.title | xml_escape }}</title><link>https://riverplo.com{{ post.url | xml_escape }}</link><guid isPermaLink="true">https://riverplo.com{{ post.url | xml_escape }}</guid><pubDate>{{ post.date | date_to_rfc822 }}</pubDate><description>{{ post.content | strip_html | xml_escape }}</description><source url="https://riverplo.com/feed.xml">Riverplo</source></item>{% endfor %}</channel></rss>
